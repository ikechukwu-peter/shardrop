        ],
        "note": "The relay carries these two sealed envelopes and is then dropped. It never sees a fingerprint in the clear."
      },
      {
        "id": "steady-state",
        "label": "Shards and acknowledgements",
        "focus": [
          "sender",
          "channel",
          "receiver",
          "store"
        ],
        "note": "Eight shards may be in flight. An ACK means stored, not merely arrived."
      },
      {
        "id": "failure",
        "label": "When a shard goes wrong",
        "focus": [
          "sender",
          "channel",
          "receiver"
        ],
        "note": "A corrupted shard is refused by its hash; a shard lost in flight is caught by a timeout, because nothing else reports it."
      }
    ]
  },
