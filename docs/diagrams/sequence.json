  "cards": [
    {
      "dot": "cyan",
      "title": "Why ACK, on a reliable channel",
      "items": [
        "SCTP already guarantees delivery and order, so an ACK is not about arrival",
        "It marks a shard as durably stored, which is what resume needs",
        "Without it the sender could not know where to continue"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why a timeout as well",
      "items": [
        "A corrupted shard produces a RETRY, because the receiver saw it",
        "A shard lost in flight produces nothing: the receiver never knew it existed",
        "Silence is its own failure, so unacknowledged shards are requeued"
      ]
    },
    {
      "dot": "amber",
      "title": "Also part of every transfer",
      "items": [
        "The offer and answer pass through a relay that can neither read nor forge them",
        "Four words from both DTLS fingerprints, shown on each screen before sending",
        "Sending stops above 1 MB buffered, resumes on bufferedamountlow"
      ]
    }
  ]
}