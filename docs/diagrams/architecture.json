          "chunk_engine",
          "manifest",
          "send_engine",
          "channel",
          "recv_engine",
          "store",
          "saved"
        ],
        "note": "Sliced, hashed, framed, verified on arrival, written to its offset. No server is on this path."
      },
      {
        "id": "pairing",
        "label": "Pairing and connectivity",
        "focus": [
          "relay",
          "ice",
          "channel"
        ],
        "note": "The relay carries sealed offers and answers only. STUN finds addresses; TURN relays encrypted bytes when no direct path exists."
      },
      {
        "id": "integrity",
        "label": "Integrity and resume",
        "focus": [
          "chunk_engine",
          "hash_pool",
          "manifest",
          "recv_engine",
          "store"
        ],
        "note": "Every shard carries a SHA-256. The store persists which shards arrived, so an interrupted transfer continues."
      }
    ],
