  "cards": [
    {
      "dot": "cyan",
      "title": "Integrity",
      "items": [
        "SHA-256 per shard, rehashed on arrival",
        "A mismatch triggers RETRY and is never stored",
        "fileId is the hash of the shard hashes",
        "Frames are reassembled per shard before a hash is checked"
      ]
    },
    {
      "dot": "emerald",
      "title": "Flow control",
      "items": [
        "Sending stops above 1 MB buffered, resumes on bufferedamountlow",
        "Eight shards in flight, bounded by the bandwidth-delay product",
        "A shard lost in flight produces no ACK and no RETRY, so an ACK timeout requeues it"
      ]
    },
    {
      "dot": "violet",
      "title": "Trust",
      "items": [
        "One pairing code derives the relay room id and an AES-256-GCM key",
        "The code rides in the URL fragment, which browsers never send to a server",
        "Four words from both DTLS fingerprints rule out a machine in the middle",
        "The relay only introduces two sockets holding the same room id"
      ]
    },
    {
      "dot": "amber",
      "title": "Resume and limits",
      "items": [
        "Shards go straight to their offset in one OPFS file",
        "READY lists the shards already stored, and the sender skips them",
        "Quota is checked before a file is accepted, not at 80%"
      ]
    }
  ]
