# Where the browser looks for the signaling relay. Read at BUILD time, so the
# site must be rebuilt after changing it.
# Local development needs nothing: it defaults to /signal on this origin,
# which Vite proxies to the local relay.
VITE_SIGNAL_URL=wss://shardrop-relay.fly.dev

# STUN discovers a browser's public address. Comma separated; these are the
# defaults, and no file ever passes through them.
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# TURN is normally NOT configured here. The browser asks the relay for
# short-lived credentials at GET /turn, so the long-lived key stays on the
# server. Set these on the RELAY instead (fly secrets set ...):
#
#   Cloudflare:  TURN_KEY_ID, TURN_KEY_API_TOKEN
#   coturn:      TURN_URL, TURN_SECRET      (static-auth-secret)
#   optional:    ALLOWED_ORIGINS=https://shardrop.vercel.app
#
# These remain as an escape hatch for a static TURN server. Anything here is
# baked into the page and visible to every visitor.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
