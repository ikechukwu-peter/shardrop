# Where the browser looks for the signaling relay.
# Local development needs nothing: it defaults to ws://<host>:8787.
VITE_SIGNAL_URL=wss://shardrop-relay.fly.dev

# STUN discovers a browser's public address. Comma separated; these are the
# defaults, and no file ever passes through them.
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# TURN relays the encrypted stream when no direct path exists, which is the
# only way to reach peers behind symmetric NAT or blocked UDP. Leave unset to
# refuse those connections instead. Use short-lived credentials: anything here
# ships to the browser.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
